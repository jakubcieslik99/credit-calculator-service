{
  "name": "credit-calculator-service",
  "version": "1.4.0",
  "description": "Credit Calculator Service",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "docker:dev": "cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml -p credit-calculator-service up --force-recreate --attach service",
    "dev": "nodemon -L --exec tsx src/index.ts",
    "build": "tsc",
    "update:all": "corepack up && pnpm update && cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml build"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.16.1+sha512.0e155aa2629db8672b49e8475da6226aa4bdea85fdcdfdc15350874946d4f3c91faaf64cbdc4a5d1ab8002f473d5c3fcedcd197989cf0390f9badd3c04678706",
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.4.0",
    "@types/nodemailer": "^7.0.1",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
