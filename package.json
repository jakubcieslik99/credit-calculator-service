{
  "name": "credit-calculator-service",
  "version": "1.6.0",
  "description": "Credit Calculator Service",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "docker:dev": "cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml -p credit-calculator-service up --force-recreate --attach service",
    "dev": "nodemon -L --exec tsx src/index.ts",
    "build": "tsc",
    "update:all": "corepack up && pnpm update && cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml build"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.22.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
