{
  "name": "credit-calculator-service",
  "version": "1.5.0",
  "description": "Credit Calculator Service",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "docker:dev": "cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml -p credit-calculator-service up --force-recreate --attach service",
    "dev": "nodemon -L --exec tsx src/index.ts",
    "build": "tsc",
    "update:all": "corepack up && pnpm update && cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml build"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "dependencies": {
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
