{
  "name": "credit-calculator-service",
  "version": "1.3.11",
  "description": "Credit Calculator Service",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "docker:dev": "cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml -p credit-calculator-service up --force-recreate --attach service",
    "dev": "nodemon -L --exec tsx src/index.ts",
    "build": "tsc",
    "update:all": "corepack up && pnpm update && cross-env DIR=credit-calculator-service docker-compose -f docker-compose.dev.yml build"
  },
  "author": "Jakub Cieślik",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^6.4.19",
    "@types/xml2js": "^0.4.14",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
